// Configuration
var PassWord = [1,2,3,4];          // PIN code sequence (4 digits)
var Damage   = 4;                  // Damage dealt on failed attempt
var Dspeed   = [0.8, 1.8];         // Knockback horizontal speed range [min, max]
var Dheight  = [0.8, 1.5];         // Knock-up vertical speed range [min, max]

// GUI IDs
var Pw_GUI   = 150;                // Password keypad GUI id
var Grid_GUI = 100;                // 27-slot storage GUI id

// ===== Set block model =====
function init (e){
e.block.setModel("refurbished_furniture:computer")
}

// ===== Entry point: right-click the scripted block =====
function interact(e) {
    var api = e.API;
    var b   = e.block;
    var p   = e.player;

    // Remember the clicked block so other events (buttons/close) can access it
    p.getTempdata().put("targ_block", b);

    // Build and show password keypad GUI
    var passwordGui = PasswordGui(p, api, 4, Pw_GUI);
    p.showCustomGui(passwordGui);
}

// ===== Build the password keypad GUI =====
function PasswordGui(p, api, length, guiId) {
    var width  = length * 30 + 20;   // Scale GUI width by PIN length
    var height = 140;
    var xStart = 10, yStart = 10;
    var xStep  = 24, yStep  = 22;
    var size   = 22;
    var labelY = yStart;             // PIN placeholders row
    var keypadY = yStart + size + 10;// Keypad top-left Y

    var gui = api.createCustomGui(guiId, width, height, false, p);

    // PIN placeholders: show "—" until digits are entered
    for (var i = 0; i < length; i++)
        gui.addLabel(1 + i, "§5§l-", xStart+5 + i * xStep, labelY+5, size, size);

    // Keypad buttons 1..9 (3x3)
    for (var i = 0; i < 9; i++) {
        var col = i % 3, row = Math.floor(i / 3);
        gui.addButton(200 + i, i+1, xStart + col * xStep, keypadY + row * yStep, size, size);
    }

    // Extra keys: 0, Delete, Enter
    gui.addButton(209,"0",   xStart + 3 * xStep, keypadY + 2 * yStep, size, size);
    gui.addButton(210,"Del", xStart + 3 * xStep, keypadY + 0 * yStep, size, size);
    gui.addButton(211,"Ent", xStart + 3 * xStep, keypadY + 1 * yStep, size, size);

    return gui;
}

// ===== Keypad button handling =====
function customGuiButton(e) {
    var id  = e.buttonId;
    var gui = e.gui;
    var p   = e.player;
    var pos = p.getPos()
    var w   = p.getWorld()
    var api = e.API;

    // Recover the target block saved on interact()
    var b = p.getTempdata().get("targ_block");

    // ---- Number key pressed (200..209 → 1..9,0) ----
    if (id >= 200 && id <= 209) {
        var digit = gui.getComponent(id).getLabel(); // Button text ("1".."9" or "0")

        // Fill the first placeholder "-" with this digit
        for (var i = 1; i <= 4; i++) {
            var lbl = gui.getComponent(i);
            if (lbl.getText() === "§5§l-") {
                lbl.setText("§5§l" + digit);
                break
            }
        }
        gui.update();
        return
    }

    // ---- Delete key: clear the last filled slot ----
    if (id === 210) { // Delete
        for (var i = 4; i >= 1; i--) {
            var lbl = gui.getComponent(i);
            if (lbl.getText() !== "§5§l-") {
                lbl.setText("§5§l-");
                break
            }
        }
        gui.update();
        return
    }

    // ---- Enter key: validate PIN ----
    if (id === 211) { // Enter
        var entered = [];
        // Extract digits from the 4 labels and build an integer array
        for (var i = 1; i <= PassWord.length; i++) {
            var number = gui.getComponent(i).getText().replace(/§.|[^0-9]/g, "");
            entered.push(parseInt(number) || "-")
        }

        // Compare with the correct password
        var correct = true;
        for (var j = 0; j < PassWord.length; j++) {
            if (entered[j] !== PassWord[j]) { var correct = false; break }
        }

        if (correct == false) {
            // Failed attempt → trigger trap timer 2 on the block
            b.timers.forceStart(1,1,false);
            p.closeGui()
            p.message("Access Denied!");
            w.playSoundAt(pos, "minecraft:block.anvil.land", 0.8, 0.9);
            w.playSoundAt(pos, "minecraft:entity.villager.no", 1.0, 1.0);
        } else if (correct == true) {
            // Success → open 27-slot GUI 
            openGridGui(p, api, b);
            w.playSoundAt(pos, "minecraft:entity.experience_orb.pickup", 1.0, 1.2);
            w.playSoundAt(pos, "minecraft:block.note_block.pling", 0.6, 1.6);
            p.message("Access Granted!");
        }
        return;
    }
}

// ===== Block timers =====
function timer(e){
    var b = e.block;
    var w = b.getWorld();
    // Timer 1: trap response on failed PIN (AoE knock, slow, damage, FX)
    if (e.id == 1){
        var ents = w.getNearbyEntities(b.x, b.y, b.z, 5, 5); // radius=5, type=5 (living)
        for(var i=0; i<ents.length; i++){
            ents[i].addPotionEffect(2, 2, 4, false); // Apply effect by ID (e.g., Slowness)
            var yaw = Math.random() * 2 * Math.PI;
            var speed = Dspeed[0] + Math.random() * (Dspeed[1]-Dspeed[0]);
            var vx = Math.cos(yaw) * speed;
            var vz = Math.sin(yaw) * speed;
            var vy = Dheight[0] + Math.random() * (Dheight[1]-Dheight[0]);
            // Launch target away (vertical + horizontal)
            ents[i].setMotionY(vy);
            ents[i].setMotionX(vx);
            ents[i].setMotionZ(vz);
            // Deal damage
            ents[i].damage(Damage)}
        // Visual/audio feedback at the block position
        w.spawnParticle("explosion", b.x, b.y+1, b.z, 0.8, 0, 0.8, 0, 5);
        w.playSoundAt(b.getPos(), "minecraft:entity.generic.explode", 1, 1)}
}

// ===== Build and open the 27-slot storage GUI =====
function openGridGui(p, api, b){
    // Store block reference for use when closing (to persist contents)
    p.getTempdata().put("targ_block", b);
    var gui = api.createCustomGui(Grid_GUI, 176, 166, false, p);
    // 27 slots (3x9) — add slots by coordinates only
    var baseX = 0, baseY = 0, step = 18, cols = 9, total = 27;
    for (var i = 0; i < total; i++){
        var x = baseX + (i % cols) * step;
        var y = baseY + Math.floor(i / cols) * step;
        gui.addItemSlot(x, y)}
    // Restore previously saved items from block Storeddata
    var S = b.getStoreddata();
    var slots = gui.getSlots();
    for (var i = 0; i < total; i++){
        var saved = S.get("slot" + i);
        if (!saved) continue;
        var nbt  = api.stringToNbt(saved);
        var item = p.getWorld().createItemFromNbt(nbt);
        if (item) slots[i].setStack(item)}
    // Show player inventory below the 3x9 grid
    gui.showPlayerInventory(baseX, baseY + (step * 3) + 36);
    // Display the GUI
    p.showCustomGui(gui);
}

