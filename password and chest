    // Ignore clicks on player inventory slots (allow normal behavior)
    if (e.slot.isPlayerSlot()) {
        // e.setCanceled(true); // Use this to block player-inventory interaction
        return;
    }
    // Add custom slot click logic here if needed
}

// ===== Persist 27-slot contents when the GUI closes =====
function customGuiClosed(e){
    var p = e.player;
    var b = p.getTempdata().get("targ_block");
    if (!b) return
    var S = b.getStoreddata();
    var slots = e.gui.getSlots();
    // Save only when the storage GUI was closed
    if (e.gui.getID() == Grid_GUI){
        // Iterate all slots and write item NBT to block Storeddata
        for (var i = 0; i < slots.length; i++){
        var st = slots[i].getStack();
        if (!st || st.getName() == "minecraft:air"){
            S.remove("slot" + i); // Clear saved entry
        } else {
            S.put("slot" + i, st.getItemNbt().toJsonString()); // Persist item as JSON NBT
        }}
        // Cleanup: forget the target block reference
        p.getTempdata().remove("targ_block");
    }
}
